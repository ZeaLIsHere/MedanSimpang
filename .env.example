# Public site token from Cloudflare Dashboard > Web Analytics.
# Add this before building the static Hostinger package.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Same-origin Cloudflare Worker route used by the public visitor counter.
# Keep the default for production; use a workers.dev URL only for local testing.
NEXT_PUBLIC_VISITOR_ANALYTICS_ENDPOINT=/api/visitors

# Token verifikasi dari Google Search Console (HTML tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
